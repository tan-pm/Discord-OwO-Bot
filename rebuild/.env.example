# Copy to .env. One local configuration for dev, local:command and register:commands.
# Use a separate Supabase development project, with migrations 001 -> 002 -> 003.
ALLOWED_GUILD_ID=
# Discord Developer Portal -> application -> General Information -> Public Key.
DISCORD_PUBLIC_KEY=
# Supabase project URL, e.g. https://<project-ref>.supabase.co (not a postgres URI).
SUPABASE_URL=
# Supabase Settings -> API Keys -> Secret keys (sb_secret_...). Backend only.
SUPABASE_SECRET_KEY=
# For an existing legacy JWT service_role key, remove SUPABASE_SECRET_KEY above
# and use this instead. Never use anon/publishable keys for the economy RPC.
# SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RELAY_SHARED_SECRET=
# Used by register:commands; registration replaces this application's guild commands.
# Use a new/private Discord application, not the original OwO application.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
